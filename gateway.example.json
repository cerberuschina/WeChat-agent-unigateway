{
  "_comment": "agent-gateway 配置。复制成 gateway.json 再改。这里演示【虚拟 iLink】接法：agent 只要把微信 base_url 指到本机网关（http://127.0.0.1:18500）就等于接上了微信，它自己零改动。",

  "account": {
    "account_id": "",
    "token": "",
    "base_url": "https://ilinkai.weixin.qq.com"
  },

  "data_dir": "data",

  "default_agent": "hermes",

  "virtual": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 18500,
    "auto_approve": ["claude"],
    "_auto_approve": "这些 agent 免人工批准：它们扫码时自动拿到网关签发的虚拟身份",
    "reuse_real_token_for": "hermes",
    "_reuse_real_token_for": "已经绑过真微信的 agent 写在这里：它连 token 都不用换，指过 base_url 就能用",
    "bind_key": "",
    "_bind_key": "远程/公网接入时必填：agent 取码要带这个预共享密钥",
    "public_url": "",
    "_public_url": "远程 agent 用的可达地址，例如 http://192.168.1.5:18500 或 http://[240e::5]:18500",
    "allow_cidrs": [],
    "_allow_cidrs": "agent 接口的来源白名单（IPv4/IPv6 均可）；空 = 不限来源（仍要 bind_key + token + 人工批准）",
    "admin_cidrs": ["127.0.0.1/32", "::1/128"],
    "_admin_cidrs": "批准页/列表/health 只对这些网段开放——公网暴露时靠它保证'人工批准'只有你能按"
  },

  "agents": {
    "hermes": {
      "type": "virtual",
      "label": "Hermes",
      "prefix": "h"
    },
    "claude": {
      "type": "virtual",
      "label": "Claude Code",
      "prefix": "c"
    },
    "workbuddy": {
      "type": "exec",
      "label": "WorkBuddy",
      "prefix": "w",
      "enabled": false,
      "command": ["workbuddy", "--prompt", "{text}"],
      "timeout": 600
    }
  },

  "_other_backend_types": {
    "_comment": "不想用虚拟 iLink 时，把某个 agent 的 type 换成下面之一（三种可混用）。这类 agent 由网关主动去调，所以它不需要自己有微信接入能力。",
    "a2a": { "type": "a2a", "url": "http://127.0.0.1:8800", "token": "", "timeout": 900 },
    "http": { "type": "http", "url": "http://127.0.0.1:3000/chat",
              "body_template": { "prompt": "{text}" }, "reply_path": "data.reply" },
    "exec": { "type": "exec", "command": ["codebuddy", "-p", "{text}"], "timeout": 600 }
  },

  "delivery": {
    "max_chars_per_message": 1800,
    "ack": true,
    "ack_template": "已转给 {label}，算完就回。",
    "error_template": "「{label}」这次没跑通：{error}",
    "queue_template": "队列里还有 {n} 条，按顺序回。"
  },

  "access": {
    "allowed_users": []
  }
}
